# live fixtures are detected within the window. Requires IMPORT_ENABLED=true
# and IMPORT_MODE=api_football.
WORLD_CUP_MATCHDAY_REFRESH_ENABLED=false  # 中文：比赛日是否自动刷新世界杯数据。
WORLD_CUP_MATCHDAY_REFRESH_INTERVAL_MINUTES=30  # 中文：比赛日自动刷新间隔分钟数。
WORLD_CUP_MATCHDAY_REFRESH_WINDOW_HOURS=6  # 中文：比赛日前后多少小时内触发刷新。

# === WORLD CUP PREDICTION MODULE ===
# Dynamic match prediction with Elo ratings, betting odds, and AI analysis

# The Odds API (betting odds data for predictions)
# Get your key at: https://the-odds-api.com/
# Free tier: 500 requests/month (~16/day)
ODDS_API_KEY=""  # 中文：The Odds API 密钥，用于拉取赔率数据。
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4  # 中文：The Odds API 基础地址；一般不用改，使用代理/镜像/自建转发时填写。
ODDS_API_ENABLED=false  # 中文：是否启用 The Odds API 拉取赔率；填 true 才会实际请求外部赔率接口。

# Football-Data.org (default World Cup fixture sync source)
FOOTBALL_DATA_API_KEY=""  # 中文：Football-Data.org API Key；默认的世界杯赛程同步源会用到，不填则 football-data 源无法拉取赛程。
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4  # 中文：Football-Data.org 基础地址；一般不用改，使用代理/镜像/自建转发时填写。

# Prediction database (separate from main loop DB)
WORLD_CUP_PREDICTION_DB_FILE=./world_cup_predictions.db  # 中文：世界杯预测模块独立数据库文件路径。

# Metaculus is a fourth candidate-event source — a community-forecasting
# platform for long-horizon science/tech/AI/policy questions (distinct from
# the market sources). Unlike the others it requires an API token; the source
# is auto-disabled when METACULUS_API_TOKEN is empty, so an unset source never
# makes authenticated network calls. Register at metaculus.com, copy your
# token from Account Settings -> API Token.
METACULUS_API_URL=https://www.metaculus.com/api2/posts/  # 中文：Metaculus API 地址。
METACULUS_API_TOKEN=""  # 中文：Metaculus API token；为空则自动禁用该来源。
METACULUS_SOURCE_NAME=Metaculus  # 中文：Metaculus 来源显示名称。

# === Phase 4: NBA Integration ===
# When false, nba- prefix match_ids return 404 and NBA components are not loaded.
PHASE4_NBA_ENABLED=false  # 中文：是否启用 NBA 篮球集成；默认关闭。
# balldontlie.io API key (free tier: 5 req/min). Empty = NBAAdapter disabled.
BALLDONTLIE_API_KEY=""  # 中文：balldontlie.io API Key；为空则自动禁用 NBA 数据源。
# NBA Elo parameters (self-computed from historical games — no external Elo source)
NBA_ELO_HFA=100  # 中文：NBA 主场优势 Elo 加成。
NBA_ELO_K_REGULAR=20  # 中文：常规赛 K 因子。
NBA_ELO_K_PLAYOFF=30  # 中文：季后赛 K 因子。
NBA_LEAGUE_AVG_TOTAL=220.0  # 中文：NBA 联盟平均总得分，用于预测比分转换。

# === Phase 5: MLB/NHL Integration ===
# When false, mlb-/nhl- prefix match_ids return 404 and MLB/NHL components are not loaded.
PHASE5_MLB_ENABLED=false  # 中文：是否启用 MLB 棒球集成；默认关闭。
PHASE5_NHL_ENABLED=false  # 中文：是否启用 NHL 冰球集成；默认关闭。
# MLB Elo parameters (self-computed from historical games — no external Elo source)
MLB_ELO_HFA=50  # 中文：MLB 主场优势 Elo 加成（棒球主场优势较低）。
MLB_ELO_K_REGULAR=20  # 中文：MLB 常规赛 K 因子。
MLB_ELO_K_PLAYOFF=30  # 中文：MLB 季后赛 K 因子。
MLB_ELO_SEASON_CARRY=0.7  # 中文：MLB 赛季间 Elo 回归保留比例（长赛季，更多回归）。
MLB_LEAGUE_AVG_TOTAL=8.5  # 中文：MLB 联盟平均总得分，用于预测比分转换。
# NHL Elo parameters
NHL_ELO_HFA=55  # 中文：NHL 主场优势 Elo 加成。
NHL_ELO_K_REGULAR=20  # 中文：NHL 常规赛 K 因子。
NHL_ELO_K_PLAYOFF=30  # 中文：NHL 季后赛 K 因子。
NHL_ELO_SEASON_CARRY=0.75  # 中文：NHL 赛季间 Elo 回归保留比例。
NHL_LEAGUE_AVG_TOTAL=5.5  # 中文：NHL 联盟平均总得分（低得分运动）。

# === Phase 7 — Sport Market Bridge Layer ===
# Connects the Sports Prediction Kernel with Polymarket + The Odds API to
# produce verified market-implied probabilities per match outcome. When the
# master flag is false, all /api/sport-* endpoints return 503 and collection
# tasks are not scheduled. All Phase 7 sub-projects default OFF to preserve
# zero-invasion — enable them individually as you wire up each layer.
# Subproject A: Bridge (link matches <-> markets, capture snapshots).
# Subproject B: Edge Detector (model-vs-market divergence -> adjusted_edge).
# Subproject C: Recommendation Engine (actionable recommendation from edges).
# Subproject D: Market Settlement Feedback (settles edges -> market calibration).
PHASE7_SPORT_MARKET_BRIDGE_ENABLED=false  # 中文：Phase 7 主开关；关闭时所有 sport-* 接口返回 503。
PHASE7_POLYMARKET_SPORTS_SOURCE_ENABLED=false  # 中文：是否启用 Polymarket 体育赛事来源。
PHASE7_ODDS_API_MULTI_LEAGUE_ENABLED=false  # 中文：是否启用 The Odds API 多联赛拉取。
PHASE7_SPORT_MARKET_BRIDGE_SCHEDULER_ENABLED=false  # 中文：是否注册 Phase 7 桥接层定时任务。
PHASE7_POLYMARKET_SPORTS_FETCH_INTERVAL_SECONDS=600  # 中文：Polymarket 体育赛事拉取间隔（秒）。
PHASE7_SPORT_MARKET_LINK_PENDING_THRESHOLD=0.6
# P1-V2 auto-verify high-confidence pending (default off)
PHASE7_SPORT_MARKET_LINK_AUTO_VERIFY_ENABLED=false
PHASE7_SPORT_MARKET_LINK_AUTO_VERIFY_THRESHOLD=0.95  # 中文：链接确认阈值；pending_confidence 低于此值不进入 verified 状态。
# Scheduler cadence (only consumed when PHASE7_SPORT_MARKET_BRIDGE_ENABLED=true).
# Polymarket discovery = hourly; traditional odds fetch = 10 min; snapshot = 1 min.
POLYMARKET_SPORTS_DISCOVERY_INTERVAL_MIN=60  # 中文：Polymarket 体育赛事发现调度间隔（分钟）。
ODDS_FETCH_INTERVAL_MIN=10  # 中文：传统赔率（The Odds API）拉取调度间隔（分钟）。
MARKET_SNAPSHOT_INTERVAL_MIN=1  # 中文：市场快照抓取调度间隔（分钟）。
# Subproject B — Edge Detector.
PHASE7_EDGE_DETECTOR_ENABLED=false  # 中文：是否启用边际检测服务；关闭时 /api/sport-edges/* 返回 503。
EDGE_DETECTION_INTERVAL_MIN=5  # 中文：边际检测调度间隔（分钟）。
# Subproject C — Recommendation Engine (stateless, no scheduler).
PHASE7_SPORT_RECOMMENDATION_ENABLED=false  # 中文：是否启用体育可执行建议引擎；关闭时 /api/sport-recommendations/* 返回 503。
# Subproject D — Market Settlement Feedback.
PHASE7_MARKET_SETTLEMENT_FEEDBACK_ENABLED=false  # 中文：是否启用市场结算反馈环；关闭时 /api/sport-settlements/* 返回 503。
PHASE7_MARKET_SETTLEMENT_SCHEDULER_ENABLED=false  # 中文：是否注册结算反馈调度任务。
MARKET_SETTLEMENT_INTERVAL_MIN=10  # 中文：结算反馈扫描调度间隔（分钟）。
MARKET_SETTLEMENT_BATCH_LIMIT=50  # 中文：每次结算扫描的最大比赛数。
MIN_SAMPLES_FOR_MARKET_CALIBRATION=10  # 中文：触发市场校准回归所需的最小样本数。
MARKET_CALIBRATION_WINDOW_SIZE=30  # 中文：市场校准滑动窗口样本数。

# === Sports Prediction OS — Master Switch ===
# KERNEL_PREDICTION_ENABLED gates all /api/predictions/* routes. When false
# (default), those routes return 503 and the system falls back to the legacy
# world_cup_prediction_pipeline. When true, the PredictionKernel handles
# wc-/ucl-/epl-/laliga-/bundesliga-/seriea-/ligue1-/nba-/mlb-/nhl- prefixed
# match_ids via the Protocol-based adapter/feature-builder/engine stack.
# --- Minimal local enable path (P0 checklist; all default OFF in production) ---
# 1) KERNEL_PREDICTION_ENABLED=true
# 2) FOOTBALL_MULTI_FACTOR_ENGINE_ENABLED=true  (optional multi-factor football)
# 3) PHASE2_LEAGUES_ENABLED=true  (if you need UCL/EPL/... adapters)
# 4) PHASE3_LEARNING_ENABLED=true only after enough settled samples
# 5) Set API_WRITE_KEY for write endpoints; never ALLOW_OPEN_WRITES in production
KERNEL_PREDICTION_ENABLED=false  # 中文：Sports Prediction OS 主开关；关闭时 /api/predictions/* 返回 503。

# Football multi-factor engine (default OFF). Requires KERNEL_PREDICTION_ENABLED.
# Registers FootballMultiFactorEngine (elo/odds/form/rest/injury/h2h) next to
# EloOddsEngine. Use POST .../predict?engine=football_multi_factor or engine=auto
# after enough settled samples. Seeds per-competition multi-factor weights without
# changing global elo=0.30 / odds=0.70 used by EloOddsEngine.
FOOTBALL_MULTI_FACTOR_ENGINE_ENABLED=false  # 中文：是否注册足球多因子引擎；关闭时仅 EloOddsEngine。

# Additional football engines (all default OFF; require KERNEL_PREDICTION_ENABLED)
DIXON_COLES_ENGINE_ENABLED=false  # 中文：Dixon-Coles（Elo→xG→rho）；需 data/dixon_coles_params.json
GBM_ENGINE_ENABLED=false          # 中文：LightGBM xG 适配；无模型时 Elo 基线
FOOTBALL_ENSEMBLE_ENGINE_ENABLED=false  # 中文：反比 Brier 融合已注册足球引擎
# Soft situational post-adjustment (knockout / must_win / group status). Register
# as engine=situational. Custom fields: must_win_home/away, home_pressure/away_pressure,
# home_group_status/away_group_status. Shifts are renormalized and capped (no hard PP).
SITUATIONAL_ENGINE_ENABLED=false  # 中文：情境引擎（软调整）；默认关

# Phase 7 Edge + Phase 10 realtime (frontend Edge 重算 / 实时价格表依赖)
# PHASE7_EDGE_DETECTOR_ENABLED=true
# PHASE10_REALTIME_PUSH_ENABLED=true
# 开发时前端 :3000 的 WebSocket 会自动连 :8000；也可用 NEXT_PUBLIC_WS_ORIGIN 覆盖

# === Phase 8 — Pipeline Completion + Calibration Fusion ===
# Completes the 2 stub scheduler jobs from Phase 7 (market snapshot capture
# + traditional odds fetch) and fuses Subproject D's market calibration into
# Subproject B's trust computation. When true, EdgeDetectorService._compute_trust
# delegates to CalibrationFusionService, which reads both Phase 3's
# KernelCalibration (avg_accuracy) and Phase 7 D's KernelMarketCalibration
# (direction_accuracy) to compute a sample-count-weighted composite trust:
#   w1 = phase3_count / total, w2 = market_count / total
#   composite = w1 * phase3_trust + w2 * market_trust
# When false (default), _compute_trust falls back to Phase 7 Phase-3-only
# behavior — zero-invasion. New table kernel_traditional_odds_snapshots stores
# traditional odds (separate from kernel_market_snapshots which holds
# Polymarket data); new read-only endpoints /api/sport-odds/{match_id}/latest
# and /history are gated by PHASE7_SPORT_MARKET_BRIDGE_ENABLED.
PHASE8_CALIBRATION_FUSION_ENABLED=false  # 中文：是否启用校准融合；关闭时 EdgeDetector 回退到 Phase 7 Phase-3-only 信任度计算。

# Phase 9 — Accuracy Sprint (default OFF). Backtest historical seasons,
# Bayesian-optimize factor weights + Elo params (Optuna TPE), and persist the
# best candidate to kernel_optimized_params. The monthly re-optimization job
# (_job_reoptimize_monthly) and weekly weight update job
# (_job_update_weights_weekly) are only registered when PHASE9_LEARNING_ACTIVATED
# is on; set the corresponding *_INTERVAL_MIN > 0 to enable each schedule.
# PHASE9_BACKTEST_SEASONS is a comma-separated list of season strings
# (e.g. "2023-24,2024-25"); PHASE9_OPTIMIZATION_TRIALS bounds the Optuna search.
PHASE9_ACCURACY_SPRINT_ENABLED=false  # 中文：是否启用 Phase 9 精度冲刺接口（/ingest、/run、/params 等）；关闭时这些接口返回 503。
PHASE9_LEARNING_ACTIVATED=false  # 中文：是否注册 Phase 9 定时任务（月度重优化 + 周度权重更新）；关闭时不注册任何 Phase 9 任务。
PHASE9_OPTIMIZATION_TRIALS=150  # 中文：Optuna TPE 单次优化搜索的试验数。
PHASE9_BACKTEST_SEASONS=2023-24,2024-25  # 中文：回测使用的赛季列表，逗号分隔。
PHASE9_OPTIMIZATION_INTERVAL_MIN=0  # 中文：月度重优化任务执行间隔（分钟）；0 表示不调度。
PHASE9_WEEKLY_WEIGHT_UPDATE_INTERVAL_MIN=0  # 中文：周度权重更新任务执行间隔（分钟）；0 表示不调度。

# === Phase 10 — Real-Time Price Push ===
# WebSocket-based real-time price push channel. When the master flag is false,
# the /ws/matches/{match_id}/prices endpoint closes connections with code 503
# and scheduler broadcast calls are no-ops. Default OFF preserves zero-invasion.
PHASE10_REALTIME_PUSH_ENABLED=false  # 中文：是否启用 WebSocket 实时价格推送；关闭时 /ws/* 端点直接返回 503。
WEBSOCKET_HEARTBEAT_INTERVAL_SECONDS=30  # 中文：服务端向已连接客户端发送心跳的间隔（秒）。
WEBSOCKET_MAX_RECONNECT_DELAY_SECONDS=30  # 中文：客户端指数退避重连的最大延迟（秒）。

# === Phase 11 — Kalshi Sports Market Integration ===
# Integrates Kalshi as a new sports market data source alongside Polymarket,
# using the existing three-layer matching engine and source-agnostic
# EdgeDetector. Reuses kernel_sport_market_links with source="kalshi" — no new
# DB tables. Kalshi API is read-only, no auth needed (uses KALSHI_API_URL).
PHASE11_KALSHI_SPORTS_ENABLED=false  # 中文：是否启用 Kalshi 体育赛事来源；默认关闭。
KALSHI_SPORTS_FETCH_INTERVAL_SECONDS=600  # 中文：Kalshi 体育赛事拉取调度间隔（秒）。
KALSHI_SPORTS_REQUEST_INTERVAL_SECONDS=1.0  # 中文：Kalshi 单次请求之间的礼貌限流间隔（秒）。

# === Phase 12 — Futures/Championship Markets ===
# Multi-leg championship market support (e.g., "Who will win the NBA Championship 2024-25?").
# When the master flag is false, /api/futures/* return 503 and scheduler jobs are
# not registered. Reuses KALSHI_API_URL from Phase 11 — no new external API.
# Zero-invasion: no modifications to match-level market code, EdgeDetector, or engines.
PHASE12_FUTURES_MARKETS_ENABLED=false  # 中文：是否启用期货/冠军市场接口（/api/futures/*）；关闭时返回 503。
FUTURES_DISCOVERY_INTERVAL_MIN=60  # 中文：期货市场发现调度间隔（分钟）。
FUTURES_SNAPSHOT_INTERVAL_MIN=5  # 中文：期货价格快照采集调度间隔（分钟）。

# LoL esports (ADR-004) — default OFF; no production API until docs/dev/lol/GATES.md P2/P3/P6
PHASE_LOL_ENABLED=false
LOL_DRY_RUN_IMPORT=false
# LOL_DRY_RUN_FIXTURES_PATH=
