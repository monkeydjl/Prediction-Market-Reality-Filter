# The Odds API Configuration
# Register at: https://the-odds-api.com/
# Free tier: 500 requests/month

# Your API key from The Odds API dashboard
ODDS_API_KEY=your_api_key_here

# Enable/disable odds API (set to true when key is configured)
ODDS_API_ENABLED=false

# Example:
# ODDS_API_KEY=1a2b3c4d5e6f7g8h9i0j
# ODDS_API_ENABLED=true
