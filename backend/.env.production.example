# Production environment configuration.
# Copy to .env.production, then set PMRF_ENV=production in the BASE backend/.env
# (or export it in the process environment) to activate.
#
# Setting PMRF_ENV inside this file does NOT activate it: config.py reads the
# base .env first, decides which overlay to load from what it finds there, and
# only then reads the overlay — so the line below is read after it has already
# been chosen. It is kept as documentation of which file this is, not as the
# switch. A misconfigured PMRF_ENV now fails at startup: an unrecognized value or
# a named-but-absent overlay raises instead of silently using development values.
#
# Values here OVERRIDE backend/.env when PMRF_ENV=production.
# NEVER commit real production secrets — use Secrets management (SOPS/Vault).
#
# Docker does not use this file at all: .dockerignore keeps .env.* out of the
# build context, so a compose deployment configures through `environment:` /
# `env_file:` and leaves PMRF_ENV unset.

PMRF_ENV=production

# Production model (set explicitly, do not inherit dev default).
OPENAI_MODEL=deepseek-chat

# Feature flags ON in production (the overlays are the product).
DECISION_QUALITY_ENABLED=true
MARKET_QUALITY_ENABLED=true
SOURCE_RELIABILITY_ENABLED=true
PREDICTION_CALIBRATION_ENABLED=true
LLM_TELEMETRY_ENABLED=true
GUARDRAILS_ENABLED=true

# Production rate limiting (generous for trusted clients behind reverse proxy).
RATE_LIMIT_MAX_REQUESTS=120
TRUSTED_PROXY_HEADER=true

# No interactive API docs in production. The schema names all 79 write
# operations and the X-API-Key / X-Operator headers they expect; the proxy
# examples block /docs, /redoc and /openapi.json as well, but only this setting
# stops the app serving them.
OPENAPI_ENABLED=false

# WARNING logging in production to reduce noise.
LOG_LEVEL=WARNING

# API write key MUST be set in production (fail-closed if empty).
API_WRITE_KEY=

# Keep write endpoints keyed. true would make every write endpoint keyless.
ALLOW_OPEN_WRITES=false

# The default is localhost-only, which blocks a real browser client. Set this
# to your actual frontend origin(s), comma-separated. Never use "*".
CORS_ALLOWED_ORIGINS=

# Never true in production: --reload re-executes the app on file changes.
SERVER_RELOAD=false

# Daily LLM spend ceiling in USD. 0 means UNLIMITED, so this template ships a
# real number — raise or lower it to match your budget, but do not set 0 on a
# paid key. With PMRF_ENV=production a non-positive cap refuses to start.
LLM_DAILY_COST_CAP_USD=25

# --- Automatic backups ----------------------------------------------------
# Whether this process runs the daily backup itself. Leave false on a systemd
# install: prediction-market-reality-filter-backup.timer already does it, and two
# writers halve the effective retention at --keep 30. deploy/docker-compose.yml
# sets it true because a container has no timer.
BACKUP_SCHEDULE_ENABLED=false

# AES-256 passphrase for the backup archive. Required whenever
# BACKUP_SCHEDULE_ENABLED=true in production, and strongly recommended either
# way: the archive contains every state store — the event store, the committed
# predictions and the kernel prediction history. With PMRF_ENV=production an
# empty key makes scripts/backup_stores.py refuse to run rather than write a
# plaintext ZIP, so this is a startup failure and not a silent downgrade.
#
# Store the passphrase somewhere other than the backup volume and do not rotate
# it without keeping the old one: an archive whose passphrase is lost is not a
# backup. Restore reads the archive's own flag bits, so old plaintext archives
# taken before this key existed still restore normally.
BACKUP_ENCRYPTION_KEY=

# --- Real-time WebSocket push ---------------------------------------------
# Safe to enable in production now: /api/ws/matches/{id}/prices authenticates its
# handshake (X-API-Key, or a single-use ticket from POST /api/ws/tickets for
# browsers — never a query-string key) and caps connections three ways. It is left
# false here because it is opt-in, not because it is unsafe.
#
# Setting it true requires all three caps below to be > 0; the preflight refuses to
# start otherwise and names the one to fix. 0 means "accept nothing", never
# "unlimited" — the HTTP rate limiter cannot cover this endpoint at all, since
# InMemoryRateLimitMiddleware never sees a WebSocket scope. The stream carries live
# bookmaker odds and Kalshi prices, so an unbounded copy of it is a data-egress
# channel, not just a load concern.
PHASE10_REALTIME_PUSH_ENABLED=false
WEBSOCKET_MAX_CONNECTIONS_TOTAL=200
WEBSOCKET_MAX_CONNECTIONS_PER_MATCH=50
WEBSOCKET_MAX_CONNECTIONS_PER_CLIENT=5
WEBSOCKET_TICKET_TTL_SECONDS=60

# false when a separate static server hosts frontend/out (see start.bat
# production mode); true lets the backend serve it on the same port.
BACKEND_SERVE_FRONTEND=true

# In-process APScheduler. Set false on every replica but one, otherwise each
# replica runs the same jobs (the lock file only guards one host).
SCHEDULER_ENABLED=true

# --- Alerting: who hears about a failed job -------------------------------
# Nothing here is set by default, and that was the whole gap: a failed
# scheduler job writes a `failed` loop_runs row, increments
# pmrf_scheduler_failed_runs_total and makes /api/health answer 503 — all three
# pull-only. Without one of the channels below, the entire trace of a 3am
# failure is a line in LOG_FILE. The backend logs "No alert push channel is
# configured" at WARNING on every boot where that is the case.
#
# Each channel needs BOTH of its settings. An enabled webhook with no URL, or a
# DSN with sentry-sdk not installed, reaches nothing outside the process.
#
# The two flags are assigned so this file states production's posture. The DSN
# and the URLs are left commented on purpose: an overlay loads with
# override=True, so `SENTRY_DSN=` here would overwrite a DSN set in the base
# backend/.env with the empty string and switch the channel back off silently.
# Uncomment and fill them here, or set them in the base .env and leave these
# alone — either works, an empty assignment does not.
#
# Sentry is the cheapest one to turn on and covers request handlers too.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#
# Webhook + Sentry breadcrumb per failed job, deduplicated per job_name.
SCHEDULER_FAILURE_ALERT_ENABLED=false
# SCHEDULER_FAILURE_ALERT_WEBHOOK_URL=https://hooks.example.com/pmrf-scheduler
#
# Calibration-drift alerts. Dispatch only fires on an authenticated
# /api/quality-metrics/drift request, so it needs a heartbeat caller; leave off
# until there are enough settled samples or it is only noise.
DRIFT_ALERTS_ENABLED=false
# DRIFT_ALERT_WEBHOOK_URL=https://hooks.example.com/pmrf-drift
