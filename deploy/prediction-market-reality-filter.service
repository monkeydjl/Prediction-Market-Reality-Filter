[Unit]
Description=Prediction Market Reality Filter API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/prediction-market-reality-filter/backend
EnvironmentFile=/etc/prediction-market-reality-filter.env
Environment=SCHEDULER_ENABLED=false
# Loopback only. This unit terminates no TLS, and /metrics + /api/health need no
# key, so binding every interface published them in the clear. Both proxy
# examples in deploy/ already forward to 127.0.0.1:8000. If the proxy runs on
# another host, widen this AND firewall the port -- see docs/ops/RUNBOOK.md.
ExecStart=/opt/prediction-market-reality-filter/.venv/bin/uvicorn app.entrypoint:load_application --factory --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
User=pmrf
Group=pmrf

# Hardening: drop privileges, sandbox filesystem, restrict kernel surface.
# All directives are fail-closed — if a path the app needs is missing from
# ReadWritePaths the service will fail with EROFS / EACCES. Adjust ReadWritePaths
# if you relocate the data dir or the venv.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/prediction-market-reality-filter/backend
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
