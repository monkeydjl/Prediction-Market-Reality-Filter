# =============================================================================
# Frontend environment variables
# =============================================================================
# Copy this file to `.env.local` for local development and fill in the values.
# In production, inject these via your deployment secret manager
# (SOPS / Vault / Doppler). Never commit real secrets.
#
# NOTE: This file is tracked in git on purpose. Keep values blank or as
# documentation only. `.env.local` and other `.env*` variants are gitignored.

# === API ===
# Backend API base URL. This is the complete externally visible API prefix, not
# just an origin. Relative paths ("/api", "/internal-api", or "/internal-api/")
# work for same-origin deploys; absolute prefixes
# ("https://host/internal-api" or "https://host/internal-api///") are needed when
# the frontend is served separately from the backend. All trailing slashes are
# normalized away before ticket and WebSocket paths append `/ws/...`; a root base
# remains `/` and joins as `/ws/...`. Custom prefixes do not add another `/api`
# segment. Root-relative paths and absolute URLs must not contain a query or
# fragment; absolute URLs also must not contain credentials. Protocol-relative
# (`//host/...`), empty, malformed, ftp, ws, and wss values are rejected before
# any authenticated request.
NEXT_PUBLIC_API_BASE=/api

# Dev-only: origin of the FastAPI backend that Next dev server proxies /api to.
# API_ORIGIN=http://localhost:8000

# === WebSocket (price push) ===
# Optional pure-origin override for the backend's standard /api/ws/... socket
# route. It must be an http(s)/ws(s) origin only: no path, query or fragment.
# The Next dev server does not proxy WebSocket upgrades, so a frontend on :3000
# connects directly to FastAPI on :8000. In a static same-origin deploy no
# override is needed. WS_ORIGIN wins over the legacy API_ORIGIN alias; http(s)
# is converted to ws(s).
# The browser reads API_WRITE_KEY only from its existing sessionStorage operator
# credentials and sends it as X-API-Key on POST /api/ws/tickets. The returned
# single-use ticket is offered as Sec-WebSocket-Protocol; neither credential is
# placed in a URL. Ticket HTTP 408/429/5xx, network/contract failures, and socket
# constructor failures share a four-retry exponential-backoff budget with socket
# close 1011/1013; a successful socket open resets it. HTTP 401/403 waits for an
# operator-credential change, and exhausting the budget stops automatic retries.
# Do not put API_WRITE_KEY in a NEXT_PUBLIC_* build variable.
# NEXT_PUBLIC_WS_ORIGIN=http://localhost:8000
# NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# === Sentry (Error Tracking) ===
# Leave any DSN empty to disable Sentry entirely (no-op, will not block app
# startup). @sentry/nextjs skips initialization when the DSN is empty, so all
# Sentry.* calls become safe no-ops.

# Server-side DSN (used by sentry.server.config.ts & sentry.edge.config.ts).
# This is a server-only secret; do NOT prefix with NEXT_PUBLIC_.
SENTRY_DSN=

# Client-side DSN (must be NEXT_PUBLIC_ to be inlined into the client bundle,
# since Next.js only exposes NEXT_PUBLIC_-prefixed vars to the browser).
# Usually the same value as SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Environment name reported to Sentry (e.g. production, staging, development).
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ENVIRONMENT=production

# Release identifier (e.g. pmrf-frontend@0.3.0). Defaults to pmrf-frontend@0.3.0.
# NEXT_PUBLIC_SENTRY_RELEASE=pmrf-frontend@0.3.0
# SENTRY_RELEASE=pmrf-frontend@0.3.0

# Traces sample rate (0.0 - 1.0). 0.0 = no performance tracing (default, kept
# consistent with the backend sampling policy). Override in production to
# enable APM.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- CI / build-time only (source map upload) ---
# Auth token used by `withSentryConfig` to upload source maps during
# `next build`. When unset, source map upload is skipped automatically.
# Do NOT commit a real token.
# SENTRY_AUTH_TOKEN=

# Sentry organization and project for source map upload.
# SENTRY_ORG=
# SENTRY_PROJECT=
