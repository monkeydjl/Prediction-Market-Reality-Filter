# Copy to .env and fill in your own values. Never commit the real .env.
# Environment selection: development (default) | staging | production
# When set to staging/production, loads .env.staging/.env.production
# which OVERRIDE values in this base .env file.
PMRF_ENV=development  # 中文：运行环境；development 本地开发，staging/production 会叠加对应环境文件。
OPENAI_API_KEY=sk-your-key-here  # 中文：旧版单接口 LLM 密钥；没有编号式配置时作为最后兜底。
OPENAI_MODEL=""  # 中文：旧版单接口模型名；没有编号式配置时作为最后兜底模型。
OPENAI_BASE_URL=""  # 中文：旧版单接口地址；非 OpenAI 官方兼容接口时填写。

# === LLM Gateway fallback routes ===
# Format: provider:model1,model2|provider2:model3
# The Gateway tries models left-to-right within a provider; if every model for
# that provider fails, it moves to the next provider/API. Leave route vars empty
# to use numbered OPENAI_API_KEY_N / OPENAI_MODEL_N_M config below, then legacy OPENAI_* if none.
LLM_ROUTE_DEFAULT=""  # 中文：显式默认 LLM 路由；留空才会自动使用编号式接口。
LLM_ROUTE_PROBABILITY_ANALYSIS=""  # 中文：概率分析任务专用 LLM 路由；留空则走默认/编号式路由。
LLM_ROUTE_TRANSLATION=""  # 中文：翻译任务专用 LLM 路由；留空则走默认/编号式路由。
LLM_ROUTE_OPEN_WEB_EXTRACTION=""  # 中文：开放网页事件抽取任务专用 LLM 路由；留空则走默认/编号式路由。
LLM_ROUTE_CROSS_VALIDATION=""  # 中文：交叉验证任务专用 LLM 路由；留空则走默认/编号式路由。
LLM_ROUTE_WORLD_CUP=""  # 中文：世界杯 AI 任务专用 LLM 路由；留空则走默认/编号式路由。
LLM_ROUTE_STARTUP_CHECK=""  # 中文：启动自检专用 LLM 路由；留空则走默认/编号式路由。
LLM_ROUTE_EMBEDDING=""  # 中文：语义相关性/向量嵌入专用路由；留空则兼容 EMBEDDING_MODEL。
LLM_TIMEOUT_SECONDS=45  # 中文：单次模型请求超时时间，单位秒。
LLM_MAX_RETRIES_PER_MODEL=1  # 中文：每个模型交给 SDK 的最大重试次数；失败后再切下一个模型。

# Optional numbered OpenAI-compatible providers. Used only when LLM_ROUTE_* is empty.
# Call order: OPENAI_API_KEY_1 models in numeric order, then OPENAI_API_KEY_2, etc.
# Each numbered provider requires OPENAI_API_KEY_N and at least one OPENAI_MODEL_N_M.
# OPENAI_BASE_URL_N can be empty for the OpenAI SDK default base URL.
# OPENAI_API_KEY_1=sk-primary-key  # 中文：第 1 个 LLM 接口的 API Key。
# OPENAI_MODEL_1_1=gpt-4o-mini  # 中文：第 1 个 LLM 接口下第 1 个模型，按编号顺序 fallback。
# OPENAI_MODEL_1_2=gpt-4.1-mini  # 中文：第 1 个 LLM 接口下第 2 个模型，按编号顺序 fallback。
# OPENAI_BASE_URL_1=https://api.openai.com/v1  # 中文：第 1 个 LLM 接口地址；非 OpenAI 官方接口需要填写。
# OPENAI_API_KEY_2=sk-secondary-key  # 中文：第 2 个 LLM 接口的 API Key。
# OPENAI_MODEL_2_1=deepseek-chat  # 中文：第 2 个 LLM 接口下第 1 个模型，按编号顺序 fallback。
# OPENAI_MODEL_2_2=deepseek-reasoner  # 中文：第 2 个 LLM 接口下第 2 个模型，按编号顺序 fallback。
# OPENAI_BASE_URL_2=https://api.deepseek.com  # 中文：第 2 个 LLM 接口地址；非 OpenAI 官方接口需要填写。
# OPENAI_API_KEY_3=sk-third-key  # 中文：第 3 个 LLM 接口的 API Key。
# OPENAI_MODEL_3_1=qwen-plus  # 中文：第 3 个 LLM 接口下第 1 个模型，按编号顺序 fallback。
# OPENAI_BASE_URL_3=https://dashscope.aliyuncs.com/compatible-mode/v1  # 中文：第 3 个 LLM 接口地址；非 OpenAI 官方接口需要填写。
# Production can fail fast on invalid primary LLM credentials/model/base URL.
# Keep false for local setup with placeholder keys.
LLM_STARTUP_CHECK_ENABLED=false  # 中文：是否在启动时校验主 LLM 配置；生产可开启，本地建议关闭。
LLM_STARTUP_CHECK_TIMEOUT_SECONDS=5  # 中文：启动自检 LLM 请求超时时间，单位秒。
GNEWS_MAX_RESULTS=10  # 中文：GNews 新闻搜索每次最多返回条数。

# Production security. Set API_WRITE_KEY in deployed environments and send it
# on mutating/costly endpoints as X-API-Key. The server REFUSES TO START with an
# empty key unless ALLOW_OPEN_WRITES=true is set (local dev only — leaves every
# write endpoint public).
API_WRITE_KEY=""  # 中文：写入/高成本接口密钥，请求时放在 X-API-Key。
ALLOW_OPEN_WRITES=false  # 中文：是否允许无密钥写入；仅本地调试可设 true，生产必须 false。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000  # 中文：允许访问后端的前端域名列表，逗号分隔。
CORS_ALLOW_CREDENTIALS=false  # 中文：CORS 是否允许携带 Cookie/凭据。
CORS_ALLOWED_HEADERS=Accept,Accept-Language,Content-Language,Content-Type,X-API-Key,X-Client-Source,X-Operator  # 中文：CORS 允许的请求头列表。
RATE_LIMIT_ENABLED=true  # 中文：是否启用接口限流。
RATE_LIMIT_WINDOW_SECONDS=60  # 中文：限流统计窗口长度，单位秒。
RATE_LIMIT_MAX_REQUESTS=120  # 中文：每个限流窗口内允许的最大请求数。
# Set to true ONLY when the app sits behind a trusted reverse proxy (nginx /
# caddy / Cloudflare) that overwrites X-Forwarded-For / X-Real-IP with the real
# client address. Default false — proxy headers are ignored on direct deploys
# so attackers cannot spoof them to bypass rate limiting.
TRUSTED_PROXY_HEADER=false  # 中文：是否信任反向代理转发的真实 IP 头；仅可信代理后开启。

# Operations
LOG_FILE=logs/app.log  # 中文：后端日志文件路径。
LOG_MAX_BYTES=10485760  # 中文：单个日志文件最大字节数，超过后轮转。
LOG_BACKUP_COUNT=5  # 中文：保留的轮转日志文件数量。
SCHEDULER_MISFIRE_GRACE_SECONDS=86400  # 中文：定时任务错过执行时间后的宽限秒数。
# Local/dev default keeps the scheduler in the API process. The systemd API
# unit overrides this to false and runs scripts/run_scheduler.py in a separate
# scheduler service instead.
SCHEDULER_ENABLED=true  # 中文：是否在当前进程启用内置定时任务。
SCHEDULER_LOCK_ENABLED=true  # 中文：是否启用调度锁，避免多进程重复跑任务。
# Scheduled event discovery (M4 loop-unblock). The scheduler freezes a
# committed prediction per market-derived event on each run; auto-resolve then
# scores them as markets settle. Set EVENT_DISCOVER_ENABLED=false to opt out of
# the scheduled run (the /events/discover route still works on demand). The
# route validator caps EVENT_DISCOVER_LIMIT at 50; the scheduler reads this
# same setting for the cron-driven run.
EVENT_DISCOVER_ENABLED=true  # 中文：是否启用定时事件发现。
# Cost note: a full /discover scan triggers ~8 outbound calls per event
# (5 HTTP full-text fetches + 1 sentiment LLM + 1 probability LLM + 1
# cross-validation LLM if enabled). At EVENT_DISCOVER_LIMIT=10 that's
# ~80 LLM calls + ~50 HTTP fetches per scan; at limit=50, ~400 LLM calls
# + ~250 HTTP fetches. Tune NEWS_SENTIMENT_MAX_ARTICLES /
# NEWS_FULL_TEXT_MAX_ARTICLES down to reduce per-event cost.
EVENT_DISCOVER_LIMIT=10  # 中文：每次事件发现最多处理的候选事件数。
# Hard timeout (seconds) for the entire discover scan. On timeout, already-
# completed candidates are saved as partial results; still-running tasks are
# cancelled. Default 600s (10 min).
EVENT_DISCOVER_TIMEOUT_SECONDS=600  # 中文：一次事件发现扫描的总超时时间，单位秒。
# Phase 1 — Decision Explanation + Conflict Layer (default OFF). When enabled,
# analyze_event attaches a decision_quality overlay block that converts
# evidence_breakdown into a structured explanation (supporting/opposing
# evidence, conflict score, downgrade reason). Pure audit layer — does NOT
# mutate ai_probability or actionable_recommendation.
DECISION_QUALITY_ENABLED=false  # 中文：是否生成决策质量解释层。
DECISION_QUALITY_MAX_EVIDENCE_ITEMS=3  # 中文：决策解释中最多展示的证据条数。
# consensus_level thresholds: HIGH is the upper bound for "high" consensus
# (conflict_score < this value means high consensus); MEDIUM is the upper
# bound for "medium" consensus. conflict_score >= HIGH means "low" consensus.
DECISION_QUALITY_HIGH_CONFLICT_THRESHOLD=0.40  # 中文：高冲突判定阈值。
DECISION_QUALITY_MEDIUM_CONFLICT_THRESHOLD=0.20  # 中文：中等冲突判定阈值。
# Phase 2 — Market Quality Layer (default OFF). When enabled, analyze_event
# attaches a market_quality overlay block for events whose
# source.type == "prediction_market" (Polymarket, Kalshi). Scores spread /
# liquidity / volume and downgrades YES/NO -> WAIT when the market is too
# thin or the spread too wide. Pure audit layer — does NOT mutate
# ai_probability or actionable_recommendation. Omitted entirely for
# non-prediction-market sources (Metaculus prediction_question, manual,
# open_web, sports_event), mirroring the freeze_prediction gate.
MARKET_QUALITY_ENABLED=false  # 中文：是否启用市场质量评分。
# Max bid/ask spread (in 0-100 probability points) before the spread penalty
# starts degrading the score. Penalty = spread / 100, capped at 1.0.
MARKET_MAX_SPREAD_PCT=12  # 中文：允许的最大买卖价差百分比。
# Liquidity / volume below these values mark the market as thin and pull the
# score below threshold. Set to 0 to disable that sub-check.
MARKET_MIN_LIQUIDITY=1000  # 中文：市场最低流动性要求。
MARKET_MIN_VOLUME=1000  # 中文：市场最低成交量要求。
# Score below this threshold triggers YES/NO -> WAIT downgrade. 0.5 means a
# market with one bad sub-score (and the others at 1.0) just barely stays.
MARKET_QUALITY_SCORE_THRESHOLD=0.5  # 中文：市场质量达标分数阈值。
# Reserved for future stale-price check. Phase 2 leaves stale_price_flag=None
# (unknown) because no adapter exposes last_updated yet — see
# docs/superpowers/audits/market-quality-field-audit.md.
MARKET_STALE_AFTER_MINUTES=180  # 中文：市场数据超过多少分钟视为过期。
# Phase 3 — Prediction Outcome Calibration (default OFF). When enabled,
# freeze_prediction captures a richer snapshot (question, recommendation,
# confidence, evidence_strength, conflict_score, market_quality_score,
# source_platform) and score_prediction computes direction_correct,
# edge_bucket, and confidence_bucket at resolve time. Long-term feature:
# only becomes valuable after enough resolved samples exist.
PREDICTION_CALIBRATION_ENABLED=false  # 中文：是否启用历史校准修正预测。
# Phase 4 — Source Reliability overlay (default OFF). When enabled,
# analyze_event attaches a source_reliability overlay block for events with
# a non-empty evidence_breakdown. Scores tier-weighted reliability, domain
# diversity, and trusted-source ratio, then downgrades YES/NO -> WAIT when
# the source base is too thin or untrustworthy. Omitted entirely when
# evidence_breakdown is empty (e.g., sports_event with match stats). Pure
# audit layer — does NOT mutate ai_probability or actionable_recommendation.
SOURCE_RELIABILITY_ENABLED=false  # 中文：是否启用来源可靠性评分。
# Overall reliability score below this threshold triggers a YES/NO -> WAIT
# downgrade. 0.5 = a single failing sub-metric (with the others at 1.0)
# just barely stays above the threshold.
SOURCE_RELIABILITY_SCORE_THRESHOLD=0.5  # 中文：来源可靠性最低分数阈值。
# Minimum fraction of sources classified as official or trusted. Below this
# ratio, the recommendation is downgraded (too few authoritative sources).
SOURCE_RELIABILITY_MIN_TRUSTED_RATIO=0.4  # 中文：可信来源最低占比要求。
# Minimum number of distinct domains in the evidence base. Below this, the
# recommendation is downgraded (single-source echo-chamber risk).
SOURCE_RELIABILITY_MIN_DOMAIN_DIVERSITY=2  # 中文：最低来源域名多样性要求。
# Minimum number of distinct sources. Below this, the recommendation is
# downgraded (source count too small to support a strong stance).
SOURCE_RELIABILITY_MIN_SOURCES=2  # 中文：最低独立来源数量。
# Phase 5 — LLM Cost and Stability Telemetry (default OFF). When enabled,
# analyze_event attaches an llm_telemetry overlay block for ALL events.
# Records degraded_mode (LLM fallback), analysis_quality, real token counts
# (captured by _ask_ai instrumentation), estimated cost, and sentiment
# degradation flag. Pure observability layer — does NOT mutate
# ai_probability, actionable_recommendation, or any decision overlay.
LLM_TELEMETRY_ENABLED=false  # 中文：是否记录 LLM 尝试、失败和降级信息。
# Review queue detectors. Disabled by default; when enabled, overlay builds and
# resolve hooks enqueue suspicious records for human review.
REVIEW_QUEUE_ENABLED=false  # 中文：是否启用人工复核队列。
REVIEW_QUEUE_MISMATCH_CONFIDENCE=0.75  # 中文：模型与市场分歧进入复核的置信度阈值。
# Auto-resolved events below this match confidence enter the review queue.
REVIEW_QUEUE_AUTO_RESOLVE_CONFIDENCE=0.95  # 中文：自动结算/自动处理所需置信度阈值。

# Conclusion challenge gate (default off). When enabled, the event and World
# Cup orchestrators run a post-conclusion negative check before strong outputs
# are published.
CONCLUSION_CHALLENGE_ENABLED=false  # 中文：是否启用结论挑战/反证检查。
CONCLUSION_CHALLENGE_LLM_CRITIC_ENABLED=false  # 中文：是否使用 LLM 对结论做批判性复核。
CONCLUSION_CHALLENGE_STRICTNESS=normal  # 中文：结论挑战严格程度。
CONCLUSION_CHALLENGE_MAX_RECOMPUTE_ATTEMPTS=1  # 中文：结论挑战触发后最多重新计算次数。
WORLD_CUP_CHALLENGE_ENABLED=false  # 中文：是否对世界杯预测启用挑战检查。
EVENT_CHALLENGE_ENABLED=false  # 中文：是否对普通事件启用挑战检查。
# P0-8 — Strategy-layer Guardrails (default OFF). When enabled,
# analyze_event applies global risk controls AFTER the per-event overlay
# merge has produced final_displayed_direction. Fires AFTER Phase 5
# llm_telemetry is populated (rule 1 reads llm_telemetry.degraded_mode).
# Strong directions (YES/NO) are downgraded to WAIT when a guardrail fires;
# the fired rule names are recorded under record["guardrail_fired"] for
# observability. Pure function with explicit config — no LLM / I/O inside
# the guardrail service. The caller (event_intelligence_service) fetches
# qualified_categories from prediction_store.calibration_summary().segments
# (best-effort: a read failure or empty calibration data skips rule 2,
# treating all categories as qualified — cold-start path stays unblocked).
GUARDRAILS_ENABLED=false  # 中文：是否启用交易/行动护栏。
# Rule 1: when llm_telemetry.degraded_mode=True (LLM fell back to
# deterministic), force YES/NO -> WAIT. The system should not commit to a
# strong stance when the underlying analysis degraded.
GUARDRAIL_LLM_DEGRADED_BLOCKS_ACT=true  # 中文：LLM 降级时是否阻止 ACT 建议。
# Rule 2: when the event's category is not "qualified"
# (prediction_store.segments reports qualified=False or the category is
# absent), force YES/NO -> WAIT. Unproven segments must accumulate samples
# before they earn the right to recommend action. Skipped when no
# calibration data exists yet (cold-start bypass).
GUARDRAIL_UNCALIBRATED_CATEGORY_BLOCKS_ACT=true  # 中文：类别未校准时是否阻止 ACT 建议。
# Rule 3: when decision_quality.conflict_score >= threshold, force YES/NO
# -> WAIT. High evidence conflict means the system cannot confidently
# pick a side. Default 0.40 matches DECISION_QUALITY_HIGH_CONFLICT_THRESHOLD.
GUARDRAIL_HIGH_CONFLICT_BLOCKS_ACT=true  # 中文：证据高冲突时是否阻止 ACT 建议。
GUARDRAIL_HIGH_CONFLICT_THRESHOLD=0.40  # 中文：护栏使用的高冲突阈值。
# Backup archive encryption (scripts/backup_stores.py). When set, backups are
# written as AES-256 encrypted zips (pyzipper); leave empty for plaintext zips
# (only safe when the backup volume is already encrypted at rest). Generate a
# strong passphrase and store it alongside your other secrets — without it the
# backups cannot be restored.
BACKUP_ENCRYPTION_KEY=""  # 中文：备份加密密钥；生产请设置强随机值。
# Optional systemd healthcheck/dead-man ping. The healthcheck script verifies
# local /api/health first, then pings PMRF_DEADMAN_URL when configured.
PMRF_HEALTHCHECK_URL=http://localhost:8000/api/health  # 中文：健康检查 ping 地址，可接 Uptime Kuma/Healthchecks。
PMRF_HEALTHCHECK_TIMEOUT_SECONDS=5  # 中文：健康检查请求超时时间，单位秒。
PMRF_DEADMAN_URL=""  # 中文：定时任务 deadman 监控地址。

# Sentry error tracking (P0-7). Empty = disabled (default). Set SENTRY_DSN to
# capture FastAPI route exceptions + scheduler job failures. The Sentry SDK
# auto-instruments FastAPI; scheduler failures are forwarded via
# app.utils.sentry.capture_exception called from scheduler._finish_run.
SENTRY_DSN=""  # 中文：Sentry 错误上报 DSN；为空则禁用。
SENTRY_ENVIRONMENT=production  # 中文：Sentry 环境名。
SENTRY_RELEASE=""  # 中文：Sentry 发布版本标识。
# Performance trace sample rate (0.0-1.0). 0 = no perf monitoring (default,
# keeps P0 minimal). Set to 0.01-0.1 in prod if performance tracing wanted.
SENTRY_TRACES_SAMPLE_RATE=0.0  # 中文：Sentry 性能追踪采样率。
SENTRY_ATTACH_STACKTRACES=true  # 中文：Sentry 是否附带堆栈信息。

# Opt-in features (disabled when left empty; re-use the primary model/provider
# when their own base-url/key are empty).
# CROSS_VALIDATION_MODEL — set to a second model id to enable independent
# probability cross-validation (a calibration signal); unset = skipped.
CROSS_VALIDATION_MODEL=""  # 中文：旧版交叉验证模型名。
# CROSS_VALIDATION_BASE_URL=  # 中文：旧版交叉验证接口地址。
# CROSS_VALIDATION_API_KEY=  # 中文：旧版交叉验证接口密钥。
OPEN_WEB_EXTRACTION_MODEL=glm-5.1  # 中文：开放网页抽取使用的模型名。

# === NEWS ANALYSIS ===
# LLM-powered sentiment analysis for prediction market events.
# When true, uses LLM to analyze news sentiment + impact (replaces the keyword
# heuristic). Costs ~1 LLM call per event (batch analysis of up to 6 articles).
# Disable to fall back to a deterministic neutral profile (no LLM cost).
NEWS_SENTIMENT_ENABLED=true  # 中文：是否启用新闻情绪 LLM 分析。
# Cap on how many articles are passed to the LLM in a single batch. Higher =
# richer context but higher token cost per call.
NEWS_SENTIMENT_MAX_ARTICLES=6  # 中文：每个事件参与情绪分析的最大新闻数。
# Full text extraction from article URLs (trafilatura). When true, fetches and
# extracts main article text for the top articles so the LLM sentiment prompt
# has more signal than title+description alone. Costs ~5 HTTP requests per event;
# falls back gracefully on failure (article keeps full_text=None).
NEWS_FULL_TEXT_FETCH_ENABLED=true  # 中文：是否抓取新闻全文增强上下文。
# Cap on how many top-ranked articles get full-text enrichment. Lower = fewer
# HTTP fetches but less context for the sentiment LLM.
NEWS_FULL_TEXT_MAX_ARTICLES=5  # 中文：每个事件最多抓取全文的新闻数。

# Per-article evidence breakdown. Extends the existing news sentiment LLM
# output with direction/strength/credibility/rationale per article. Audit
# layer only; does NOT affect probability calculation.
EVIDENCE_BREAKDOWN_ENABLED=true  # 中文：是否生成逐文章证据拆解。

# === ACTIONABLE CONCLUSIONS ===
# Structured direction + confidence + allocation recommendation on event records.
# When true, surfaces the already-computed LONG/SHORT signal as
# actionable_recommendation (direction YES/NO/AVOID/WAIT + confidence +
# suggested allocation pct). Disable to keep the legacy vague
# recommended_action strings only.
ACTIONABLE_RECOMMENDATION_ENABLED=true  # 中文：是否生成可执行方向和仓位建议。
# Auto-translate event titles to Simplified Chinese during discovery.
# When true (default), every discovered event gets a dedicated lightweight
# translation call if the main LLM analysis did not produce a Chinese title.
# Disable if you don't need Chinese titles or want to save LLM calls.
AUTO_TRANSLATE_TITLES=true  # 中文：是否自动把事件标题翻译成中文。
# Cold-start bypass: when a category is dormant (0 resolved samples) but the
# adjusted edge exceeds act_edge, emit "provisional_act" instead of "watch".
# This unblocks the system during cold-start (otherwise dormant categories
# never earn "act" regardless of edge, causing a dead loop until markets
# settle weeks/months later). Disable to restore old behavior.
COLD_START_BYPASS_ENABLED=true  # 中文：冷启动类别是否允许在强边际下临时 ACT。

# Curated 2026 FIFA World Cup source. It adds local sports-event candidates to
# discovery; set false to disable the vertical mode.
WORLD_CUP_SOURCE_ENABLED=true  # 中文：是否启用世界杯候选事件来源。
WORLD_CUP_SOURCE_NAME=2026 FIFA World Cup  # 中文：世界杯来源显示名称。
SPORTS_FACT_FILE=./sports_facts.json  # 中文：体育事实数据文件路径。
WORLD_CUP_DATA_FILE=./world_cup_data.json  # 中文：世界杯基础数据文件路径。
WORLD_CUP_SOURCE_BUNDLE_FILE=./world_cup_source_bundle.json  # 中文：世界杯数据包本地文件路径。
WORLD_CUP_SOURCE_BUNDLE_URL=""  # 中文：世界杯数据包远程 URL。
WORLD_CUP_MATCH_SOURCE_URL=""  # 中文：世界杯赛程数据源 URL。
WORLD_CUP_MATCH_EVENTS_SOURCE_URL=""  # 中文：世界杯比赛事件数据源 URL。
WORLD_CUP_LINEUPS_SOURCE_URL=""  # 中文：世界杯首发/阵容数据源 URL。
WORLD_CUP_STANDINGS_SOURCE_URL=""  # 中文：世界杯积分榜数据源 URL。
WORLD_CUP_PLAYER_AWARDS_SOURCE_URL=""  # 中文：世界杯球员奖项数据源 URL。
WORLD_CUP_PLAYER_STATUS_SOURCE_URL=""  # 中文：世界杯球员伤停/状态数据源 URL。
WORLD_CUP_STATISTICS_SOURCE_URL=""  # 中文：世界杯统计数据源 URL。
WORLD_CUP_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io  # 中文：API-Football 接口基础地址。
WORLD_CUP_API_FOOTBALL_API_KEY=""  # 中文：API-Football 密钥。
WORLD_CUP_API_FOOTBALL_LEAGUE_ID=1  # 中文：API-Football 世界杯联赛 ID。
WORLD_CUP_API_FOOTBALL_SEASON=2026  # 中文：API-Football 赛季年份。
WORLD_CUP_API_FOOTBALL_FETCH_EVENTS=false  # 中文：是否从 API-Football 拉取比赛事件。
WORLD_CUP_API_FOOTBALL_FETCH_LINEUPS=false  # 中文：是否从 API-Football 拉取阵容。
WORLD_CUP_API_FOOTBALL_FETCH_STATISTICS=false  # 中文：是否从 API-Football 拉取技术统计。
WORLD_CUP_API_FOOTBALL_MAX_DETAIL_CALLS=100  # 中文：API-Football 详情接口最大调用次数。
WORLD_CUP_SPORTMONKS_API_TOKEN=""  # 中文：SportMonks API token。
WORLD_CUP_SPORTMONKS_FIXTURES_URL=""  # 中文：SportMonks 赛程接口 URL。
WORLD_CUP_SPORTMONKS_STANDINGS_URL=""  # 中文：SportMonks 积分榜接口 URL。
WORLD_CUP_SPORTMONKS_TOP_SCORERS_URL=""  # 中文：SportMonks 射手榜接口 URL。
WORLD_CUP_SOURCE_BUNDLE_TIMEOUT_SECONDS=10.0  # 中文：世界杯数据包下载超时时间，单位秒。
WORLD_CUP_SOURCE_BUNDLE_MAX_BYTES=2097152  # 中文：世界杯数据包允许的最大字节数。
WORLD_CUP_SOURCE_BUNDLE_USER_AGENT=Event Intelligence Platform research-contact@example.com  # 中文：请求世界杯数据包时使用的 User-Agent。
WORLD_CUP_SOURCE_BUNDLE_AUTH_HEADER=""  # 中文：世界杯数据包请求认证 header 名。
WORLD_CUP_SOURCE_BUNDLE_AUTH_VALUE=""  # 中文：世界杯数据包请求认证 header 值。
# === WORLD CUP LIVE DATA — ACTIVATION CHECKLIST ===
# 1. Set WORLD_CUP_API_FOOTBALL_API_KEY from your api-sports.io dashboard
# 2. Set WORLD_CUP_SOURCE_BUNDLE_IMPORT_ENABLED=true
# 3. Set WORLD_CUP_SOURCE_BUNDLE_IMPORT_MODE=api_football
# 4. (Optional) Enable matchday refresh for near-realtime during games:
#    WORLD_CUP_MATCHDAY_REFRESH_ENABLED=true  # 中文：比赛日是否自动刷新世界杯数据。
# 5. Use the "测试连接" button on /world-cup to verify connectivity

WORLD_CUP_SOURCE_BUNDLE_IMPORT_ENABLED=false  # 中文：是否启用世界杯数据包定时导入。
WORLD_CUP_SOURCE_BUNDLE_IMPORT_MODE=url  # 中文：世界杯数据导入模式，如 url 或 api_football。
WORLD_CUP_SOURCE_BUNDLE_IMPORT_REPLACE=false  # 中文：导入时是否替换现有世界杯数据。
WORLD_CUP_SOURCE_BUNDLE_IMPORT_HOUR_UTC=5  # 中文：世界杯数据定时导入的 UTC 小时。
WORLD_CUP_SOURCE_BUNDLE_IMPORT_MINUTE_UTC=20  # 中文：世界杯数据定时导入的 UTC 分钟。
WORLD_CUP_DATA_MAX_AGE_HOURS=168  # 中文：世界杯数据超过多少小时视为过期。

# Match-day auto-refresh: re-imports API-Football data every N minutes when
# live fixtures are detected within the window. Requires IMPORT_ENABLED=true
# and IMPORT_MODE=api_football.
WORLD_CUP_MATCHDAY_REFRESH_ENABLED=false  # 中文：比赛日是否自动刷新世界杯数据。
WORLD_CUP_MATCHDAY_REFRESH_INTERVAL_MINUTES=30  # 中文：比赛日自动刷新间隔分钟数。
WORLD_CUP_MATCHDAY_REFRESH_WINDOW_HOURS=6  # 中文：比赛日前后多少小时内触发刷新。

# === WORLD CUP PREDICTION MODULE ===
# Dynamic match prediction with Elo ratings, betting odds, and AI analysis

# The Odds API (betting odds data for predictions)
# Get your key at: https://the-odds-api.com/
# Free tier: 500 requests/month (~16/day)
ODDS_API_KEY=""  # 中文：The Odds API 密钥，用于拉取赔率数据。
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4  # 中文：The Odds API 基础地址；一般不用改，使用代理/镜像/自建转发时填写。
ODDS_API_ENABLED=false  # 中文：是否启用 The Odds API 拉取赔率；填 true 才会实际请求外部赔率接口。

# Football-Data.org (default World Cup fixture sync source)
FOOTBALL_DATA_API_KEY=""  # 中文：Football-Data.org API Key；默认的世界杯赛程同步源会用到，不填则 football-data 源无法拉取赛程。
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4  # 中文：Football-Data.org 基础地址；一般不用改，使用代理/镜像/自建转发时填写。

# Prediction database (separate from main loop DB)
WORLD_CUP_PREDICTION_DB_FILE=./world_cup_predictions.db  # 中文：世界杯预测模块独立数据库文件路径。

# Metaculus is a fourth candidate-event source — a community-forecasting
# platform for long-horizon science/tech/AI/policy questions (distinct from
# the market sources). Unlike the others it requires an API token; the source
# is auto-disabled when METACULUS_API_TOKEN is empty, so an unset source never
# makes authenticated network calls. Register at metaculus.com, copy your
# token from Account Settings -> API Token.
METACULUS_API_URL=https://www.metaculus.com/api2/posts/  # 中文：Metaculus API 地址。
METACULUS_API_TOKEN=""  # 中文：Metaculus API token；为空则自动禁用该来源。
METACULUS_SOURCE_NAME=Metaculus  # 中文：Metaculus 来源显示名称。
