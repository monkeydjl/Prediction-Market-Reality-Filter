# Copy to .env and fill in your own values. Never commit the real .env.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=deepseek-v3.2
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GNEWS_MAX_RESULTS=10

# Production security. Set API_WRITE_KEY in deployed environments and send it
# on mutating/costly endpoints as X-API-Key.
API_WRITE_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Operations
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SCHEDULER_MISFIRE_GRACE_SECONDS=86400

# Opt-in features (disabled when left empty; re-use the primary model/provider
# when their own base-url/key are empty).
# CROSS_VALIDATION_MODEL — set to a second model id to enable independent
# probability cross-validation (a calibration signal); unset = skipped.
CROSS_VALIDATION_MODEL=
# CROSS_VALIDATION_BASE_URL=
# CROSS_VALIDATION_API_KEY=
OPEN_WEB_EXTRACTION_MODEL=glm-5.1
