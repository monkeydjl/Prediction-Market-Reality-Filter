# Staging environment configuration.
# Copy to .env.staging, then set PMRF_ENV=staging in the BASE backend/.env (or
# export it in the process environment) to activate.
#
# Setting PMRF_ENV inside this file does NOT activate it: config.py reads the
# base .env first, decides which overlay to load from what it finds there, and
# only then reads the overlay — so the line below is read after it has already
# been chosen. It is kept as documentation of which file this is, not as the
# switch. A misconfigured PMRF_ENV now fails at startup: an unrecognized value or
# a named-but-absent overlay raises instead of silently using development values.
#
# Values here OVERRIDE backend/.env when PMRF_ENV=staging.

PMRF_ENV=staging

# Use cheaper model in staging to control cost.
OPENAI_MODEL=deepseek-chat

# Feature flags default OFF in staging (safer for pre-prod).
DECISION_QUALITY_ENABLED=false
MARKET_QUALITY_ENABLED=false
SOURCE_RELIABILITY_ENABLED=false
PREDICTION_CALIBRATION_ENABLED=false
LLM_TELEMETRY_ENABLED=false
GUARDRAILS_ENABLED=false

# Stricter rate limiting in staging.
RATE_LIMIT_MAX_REQUESTS=60

# INFO logging in staging.
LOG_LEVEL=INFO

# Staging writes should still be keyed — it usually points at real API keys.
API_WRITE_KEY=
ALLOW_OPEN_WRITES=false

# Set this to the staging frontend origin(s), comma-separated. Left empty the
# base .env value carries over, which is localhost-only. Never use "*".
CORS_ALLOWED_ORIGINS=

# --reload re-executes the app on file changes; staging should behave like prod.
SERVER_RELOAD=false

# Daily LLM spend ceiling in USD. 0 means UNLIMITED. Staging is where a
# runaway loop is most likely, so this template ships a small real number.
LLM_DAILY_COST_CAP_USD=5
